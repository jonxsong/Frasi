# Browser-visible API origin
NEXT_PUBLIC_API_URL=http://localhost:8000

# API
FRASI_ENV=development
FRASI_DATABASE_URL=postgresql+psycopg://frasi:frasi@postgres:5432/frasi
FRASI_REDIS_URL=redis://redis:6379/0
FRASI_STORAGE_BACKEND=s3
FRASI_STORAGE_ROOT=/data/assets
FRASI_JWT_SECRET=replace-with-at-least-32-random-characters
FRASI_CORS_ORIGINS=http://localhost:3000
FRASI_MAX_UPLOAD_MB=200

# S3-compatible object storage (RustFS in the local Compose stack)
FRASI_S3_ENDPOINT=http://object-storage:9000
FRASI_S3_ACCESS_KEY=frasi
FRASI_S3_SECRET_KEY=replace-me
FRASI_S3_BUCKET=frasi-audio
# Base64-encoded 32-byte SSE-S3 master key; generate a unique production value.
FRASI_S3_MASTER_KEY=

# Optional official external integrations
FRASI_YOUTUBE_API_KEY=
FRASI_SPOTIFY_CLIENT_ID=
FRASI_SPOTIFY_CLIENT_SECRET=
